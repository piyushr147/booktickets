{
  "info": {
    "name": "Booktickets API (Render)",
    "description": "Postman collection for the deployed service. Demo mint-secret values are prefilled in the collection and guide; set the matching Render environment variables before running requests. Request scripts automatically save access tokens, showId, idempotencyKey, and reservationId. See POSTMAN_API_GUIDE.md for the test steps and import-ready cURL requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "userMintSecret",
      "value": "ItbOqFPpk6RwBLs0T1cflDo8K9D3sjXz0DVB05kWQx8"
    },
    {
      "key": "adminMintSecret",
      "value": "M64S0SRpseMp5a-zOZfReH_bHSrOzG9FOxH929sN99k"
    },
    {
      "key": "userToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "showId",
      "value": ""
    },
    {
      "key": "reservationId",
      "value": ""
    },
    {
      "key": "idempotencyKey",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health and metrics",
      "item": [
        {
          "name": "Liveness",
          "request": {
            "method": "GET",
            "url": "https://booktickets-uee9.onrender.com/health/live"
          }
        },
        {
          "name": "Readiness (checks PostgreSQL)",
          "request": {
            "method": "GET",
            "url": "https://booktickets-uee9.onrender.com/health/ready"
          }
        },
        {
          "name": "Actuator health",
          "request": {
            "method": "GET",
            "url": "https://booktickets-uee9.onrender.com/actuator/health"
          }
        },
        {
          "name": "Actuator liveness probe",
          "request": {
            "method": "GET",
            "url": "https://booktickets-uee9.onrender.com/actuator/health/liveness"
          }
        },
        {
          "name": "Actuator readiness probe",
          "request": {
            "method": "GET",
            "url": "https://booktickets-uee9.onrender.com/actuator/health/readiness"
          }
        },
        {
          "name": "Prometheus metrics",
          "request": {
            "method": "GET",
            "url": "https://booktickets-uee9.onrender.com/actuator/prometheus"
          }
        }
      ]
    },
    {
      "name": "Authentication / token minting",
      "item": [
        {
          "name": "Mint admin token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin token minted', function () { pm.response.to.have.status(200); });",
                  "pm.collectionVariables.set('adminToken', pm.response.json().access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Token-Mint-Secret",
                "value": "{{adminMintSecret}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"postman-admin\",\n  \"role\": \"ADMIN\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "https://booktickets-uee9.onrender.com/auth/token"
          }
        },
        {
          "name": "Mint user token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('User token minted', function () { pm.response.to.have.status(200); });",
                  "pm.collectionVariables.set('userToken', pm.response.json().access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Token-Mint-Secret",
                "value": "{{userMintSecret}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"postman-user\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "https://booktickets-uee9.onrender.com/auth/token"
          }
        },
        {
          "name": "Mint batch of user tokens",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Token-Mint-Secret",
                "value": "{{userMintSecret}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_ids\": [\"postman-user-1\", \"postman-user-2\"]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "https://booktickets-uee9.onrender.com/auth/tokens"
          }
        }
      ]
    },
    {
      "name": "Shows",
      "item": [
        {
          "name": "Create show (ADMIN; saves showId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Show created', function () { pm.response.to.have.status(201); });",
                  "const show = pm.response.json();",
                  "pm.collectionVariables.set('showId', show.id);",
                  "pm.collectionVariables.set('idempotencyKey', 'postman-' + show.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"postman-{{$guid}}\",\n  \"seats\": [\"A1\", \"A2\", \"A3\"],\n  \"price_paise\": 25000,\n  \"per_user_limit\": 4\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "https://booktickets-uee9.onrender.com/shows"
          }
        },
        {
          "name": "Get show and seat availability",
          "request": {
            "method": "GET",
            "url": "https://booktickets-uee9.onrender.com/shows/{{showId}}"
          }
        }
      ]
    },
    {
      "name": "Reservations",
      "item": [
        {
          "name": "Reserve seat (USER; saves reservationId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Reservation created', function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set('reservationId', pm.response.json().reservation_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"seats\": [\"A1\"]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "https://booktickets-uee9.onrender.com/shows/{{showId}}/reserve"
          }
        },
        {
          "name": "Retry same reservation (idempotent replay)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Stored result replayed', function () { pm.response.to.have.status(201); pm.expect(pm.response.headers.get('Idempotency-Replayed')).to.eql('true'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"seats\": [\"A1\"]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "https://booktickets-uee9.onrender.com/shows/{{showId}}/reserve"
          }
        },
        {
          "name": "Cancel reservation (owner USER)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": "https://booktickets-uee9.onrender.com/reservations/{{reservationId}}/cancel"
          }
        }
      ]
    }
  ]
}